{
  "name": "Ecommerce Catalogue QA Automation Platform",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "development"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "tailwindcss.tailwindcss"
      ]
    }
  },
  "remoteEnv": {
    "NODE_OPTIONS": "--no-experimental-global-navigator"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Express + Vite Dev Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm ci && npm run setup:browser"
}
