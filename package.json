{
  "name": "paxth-qa-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run clean && vite build && npm run build:server",
    "build:server": "esbuild server.ts src/server/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server --entry-names=[name]",
    "start": "node dist/server/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:job-state": "tsx src/lib/jobRunState.test.ts",
    "test:spreadsheet": "tsx src/lib/catalogWorkbook.test.ts",
    "test:legacy-backup": "tsx src/lib/legacyBackup.test.ts",
    "test:site-selector": "tsx src/lib/siteSelectorWebsite.test.ts",
    "test:tab-capture": "tsx src/lib/captureDynamicTabs.test.ts",
    "test:blocked-page": "tsx src/lib/blockedScrapePage.test.ts",
    "test:lazy-content": "tsx src/lib/loadLazyPageContent.test.ts",
    "test:api": "tsx src/lib/api.test.ts",
    "test:server-security": "tsx src/server/security.test.ts",
    "test:migrations": "tsx src/server/migration.integration.test.ts",
    "test:api-db": "tsx src/server/api.integration.test.ts",
    "test:worker-db": "tsx src/server/worker.integration.test.ts",
    "test": "npm run test:job-state && npm run test:spreadsheet && npm run test:legacy-backup && npm run test:site-selector && npm run test:tab-capture && npm run test:blocked-page && npm run test:lazy-content && npm run test:api && npm run test:server-security",
    "auth:hash": "node scripts/hash-password.mjs",
    "db:migrate": "node dist/server/migrate.js",
    "db:migrate:dev": "tsx src/server/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "cloakbrowser": "0.5.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
