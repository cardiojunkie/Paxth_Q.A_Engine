{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build --outDir dist/public && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs && esbuild scripts/bootstrap-admin.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bootstrap-admin.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview --outDir dist/public",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:job-state": "tsx src/lib/jobRunState.test.ts",
    "test:llm-response": "tsx src/lib/llmResponse.test.ts",
    "test:qa-agent": "tsx src/hooks/useSettings.test.ts && tsx src/lib/qaAgent.test.ts",
    "test:sap-editor": "tsx src/components/DashboardModule.test.ts",
    "test:qa-config-db": "tsx src/db/qaConfiguration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:scraper": "tsx src/lib/cloudScrape.test.ts && tsx src/lib/scrapeRequest.test.ts && tsx src/server/scraper.test.ts && tsx src/server/scrapePipeline.test.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test:provider": "tsx src/server/provider.test.ts",
    "test:auth": "tsx src/server/auth.test.ts",
    "test:security-db": "tsx src/server/security.test.ts",
    "test:catalog": "tsx src/server/catalog.test.ts",
    "test:catalog-generation": "tsx src/lib/catalogGeneration.test.ts && tsx src/lib/catalogFiles.test.ts",
    "test:catalog-browser": "tsx src/components/CatalogMode.test.ts",
    "test": "npm run lint && npm run test:auth && npm run test:provider && npm run test:catalog && npm run test:catalog-generation && npm run test:job-state && npm run test:job-runner && npm run test:llm-response && npm run test:qa-agent && npm run test:scraper",
    "test:job-runner": "tsx src/server/jobRunner.test.ts",
    "setup:browser": "playwright-core install chromium",
    "test:scrape-production": "node scripts/smoke-scraper.mjs",
    "test:scrape-live": "tsx scripts/test-live-scraper.ts"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "playwright-core": "^1.62.1"
  }
}
