# deploy.env: non-secret Compose inputs
APP_IMAGE=ghcr.io/cardiojunkie/paxth-qa-engine@sha256:REPLACE_WITH_RELEASE_DIGEST
APP_DOMAIN=enzqm.aiccloud.online
ACME_EMAIL=ops@example.com
RUNTIME_ENV_FILE=/etc/paxth-qa/runtime.env
MIGRATE_ENV_FILE=/etc/paxth-qa/migrate.env

# runtime.env: copy only this block to a root-owned chmod 600 file
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full
PUBLIC_ORIGIN=https://enzqm.aiccloud.online
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SCRYPT='scrypt$131072$8$1$REPLACE_SALT_BASE64$REPLACE_HASH_BASE64'
SESSION_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_OF_EXACTLY_32_RANDOM_BYTES
CLOAKBROWSER_LICENSE_KEY=REPLACE_WITH_LICENSE_KEY
CLOAKBROWSER_VERSION=146.0.7680.177.5

# migrate.env: copy only this line to a separate root-owned chmod 600 file
DATABASE_MIGRATION_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full
