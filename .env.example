# Database Connection String for PostgreSQL (e.g. Supabase, Neon)
# For Supabase, paste the exact Dashboard → Connect → Session pooler URI. Do not
# alter its region, port, or username; it should include ?sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paxth_qa_engine

# Required production HTTPS origin. Development detects Codespaces or uses the local origin when empty.
# Keep production backend access behind Caddy and the loopback binding.
APP_ORIGIN=
# For a native systemd deployment; Docker keeps its default 0.0.0.0 binding.
# HOST=127.0.0.1
# Shared server-only OpenAI-compatible provider credentials; configure both overrides together.
# Existing AICREDITS_API_KEY works with https://api.aicredits.in/v1 when neither LLM override is set.
# Never exposed to browsers or model context.
LLM_BASE_URL=https://api.aicredits.in/v1
LLM_API_KEY=
# One-time bootstrap command only; do not retain these in the deployed environment.
# If omitted, admin:bootstrap uses Aswath / potusdown@2230.
# BOOTSTRAP_ADMIN_USERNAME=your-admin-name
# BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-password-of-at-least-12-characters

# Q&A model settings are editable in LLM Settings. Scraping needs no provider credentials.
# Native deployments can override the worker Python path (Docker sets this automatically).
# SCRAPER_PYTHON=/opt/paxth-qa/.venv/bin/python
# Public CloakBrowser binary, installed by setup:scraper; runtime downloads are disabled.
CLOAKBROWSER_VERSION=146.0.7680.177.5
# A supplied newer binary/entitlement may override the version and local binary path.
# CLOAKBROWSER_BINARY_PATH=/opt/chromium/chrome
# CLOAKBROWSER_LICENSE_KEY=
# Headed Xvfb is the production default; this override is intended for fixture tests.
# SCRAPER_HEADLESS=true
